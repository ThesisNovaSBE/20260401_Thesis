[MASTER]
# Fail if rating drops below this
fail-under=10.0

[MESSAGES CONTROL]
# R0801: duplicate-code — fixed by extracting src/stage2/_utils.py
disable=R0801

[FORMAT]
max-line-length=100

[DESIGN]
# ML training functions legitimately pass model, cfg, seed, device, etc.
max-args=9
# Positional-only argument limit; keyword-only args are excluded from this count.
max-positional-arguments=8
# Config dataclasses and training functions need more attributes/locals.
max-locals=25
max-attributes=20
# Training loop bodies exceed the default 50.
max-statements=70
# Trainer subclass has exactly one overridden method — that is correct design.
max-public-methods=20
min-public-methods=1

[TYPECHECK]
# Optional heavy deps that may not be installed in the lint environment.
# We guard these with try/except ImportError in each file.
ignored-modules=torch,torchvision,transformers,xgboost,optuna,ollama

[BASIC]
# Allow single-letter 'n' used as count variable in synthetic data helpers.
good-names=i,j,k,n,f,e,x,y

[SIMILARITIES]
# Minimum lines required to trigger duplicate-code detection.
min-similarity-lines=10
