# Copy this file to .env and fill in your local paths.
# These paths are NEVER committed — .env is gitignored.

# Path to your local MIMIC-IV extract (the folder containing hosp/, icu/ subdirs)
MIMIC_IV_DIR=

# Path to your local MIMIC-IV-Note extract (the folder containing discharge.csv.gz, etc.)
MIMIC_IV_NOTE_DIR=

# Leave both blank to use synthetic data instead.
